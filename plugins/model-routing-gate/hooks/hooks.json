{
  "description": "Passive subagent lifecycle diagnostics; configured model requests remain distinct from runtime evidence.",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/model-routing-gate-hook.sh\" hook",
            "timeout": 10,
            "statusMessage": "Recording subagent lifecycle coverage"
          }
        ]
      }
    ]
  }
}
