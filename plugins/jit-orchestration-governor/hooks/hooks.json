{
  "description": "Advisory-first JIT orchestration guard for PreToolUse action metadata.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/jit-orchestration-governor.mjs\" hook",
            "timeout": 5,
            "statusMessage": "Checking JIT orchestration evidence"
          }
        ]
      }
    ]
  }
}
