{
  "description": "Advisory-first JIT refresh and bounded orchestration/completion feedback.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/jit-orchestration-governor.mjs\" hook",
            "timeout": 5,
            "statusMessage": "Refreshing JIT governance context",
            "additionalContextLimit": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/jit-orchestration-governor.mjs\" hook",
            "timeout": 5,
            "statusMessage": "Checking JIT orchestration evidence"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/jit-orchestration-governor.mjs\" hook",
            "timeout": 5,
            "statusMessage": "Checking bounded completion contract"
          }
        ]
      }
    ]
  }
}
