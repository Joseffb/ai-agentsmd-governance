{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-codex-governance/schemas/manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "estimator",
    "budgets",
    "operation_catalog",
    "modules",
    "authority_model",
    "tool_catalog",
    "risk_tag_catalog"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "estimator": {
      "type": "object"
    },
    "control_levels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_control_level": {
      "type": "string"
    },
    "budgets": {
      "type": "object"
    },
    "project_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operation_catalog": {
      "type": "object"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "authority_model": {
      "type": "object"
    },
    "tool_catalog": {
      "type": "object"
    },
    "risk_tag_catalog": {
      "type": "object"
    }
  }
}
